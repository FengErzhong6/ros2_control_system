<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="marvin_dual_ros2_control"
               params="name
                       use_mock_hardware:=false
                       joint_vel_ratio:=80  joint_acc_ratio:=80
                       gripper_velocity:=255  gripper_acceleration:=255
                       gripper_command_rate_hz:=50.0  gripper_command_epsilon:=0.001
                       collision_guard_enabled:=false
                       collision_guard_check_rate_hz:=30.0
                       collision_guard_min_command_delta_deg:=0.0
                       collision_guard_near_distance_m:=0.10
                       collision_guard_hard_collision_distance_m:=0.05
                       collision_guard_escape_min_distance_improvement_m:=0.001
                       collision_guard_interpolation_steps:=6
                       collision_guard_binary_search_steps:=5
                       mock_grippers:=false
                       use_gripper_L:=false  gripper_L_arm:=A  gripper_L_can_id:=1
                       use_gripper_R:=false  gripper_R_arm:=B  gripper_R_can_id:=2">

    <ros2_control name="${name}" type="system">
      <hardware>
        <xacro:if value="${str(use_mock_hardware).lower() == 'true'}">
          <plugin>mock_components/GenericSystem</plugin>
          <param name="mock_sensor_commands">false</param>
          <param name="state_following_offset">0.0</param>
        </xacro:if>
        <xacro:unless value="${str(use_mock_hardware).lower() == 'true'}">
          <plugin>marvin_system/MarvinHardware</plugin>
          <param name="ip">192.168.1.190</param>
          <param name="joint_vel_ratio">${joint_vel_ratio}</param>
          <param name="joint_acc_ratio">${joint_acc_ratio}</param>
          <param name="gripper_velocity">${gripper_velocity}</param>
          <param name="gripper_acceleration">${gripper_acceleration}</param>
          <param name="gripper_command_rate_hz">${gripper_command_rate_hz}</param>
          <param name="gripper_command_epsilon">${gripper_command_epsilon}</param>
          <param name="mock_grippers">${mock_grippers}</param>
          <param name="connect_timeout_ms">1500</param>
          <param name="state_timeout_ms">8000</param>
          <param name="activation_retry_settle_ms">2000</param>
          <param name="activation_max_attempts">3</param>
          <param name="no_frame_timeout_ms">800</param>
          <param name="sdk_log_enabled">0</param>
          <param name="home_position_L">1.16 -1.28 -1.5707963 -1.25 0 0 0</param>
          <param name="home_position_R">-1.16 -1.28 1.5707963 -1.25 0 0 0</param>

          <param name="mount_xyz_L">$(arg left_xyz)</param>
          <param name="mount_rpy_L">$(arg left_rpy)</param>
          <param name="mount_xyz_R">$(arg right_xyz)</param>
          <param name="mount_rpy_R">$(arg right_rpy)</param>
          <param name="collision_guard_enabled">${collision_guard_enabled}</param>
          <param name="collision_guard_check_rate_hz">${collision_guard_check_rate_hz}</param>
          <param name="collision_guard_min_command_delta_deg">${collision_guard_min_command_delta_deg}</param>
          <param name="collision_guard_near_distance_m">${collision_guard_near_distance_m}</param>
          <param name="collision_guard_hard_collision_distance_m">${collision_guard_hard_collision_distance_m}</param>
          <param name="collision_guard_escape_min_distance_improvement_m">${collision_guard_escape_min_distance_improvement_m}</param>
          <param name="collision_guard_interpolation_steps">${collision_guard_interpolation_steps}</param>
          <param name="collision_guard_binary_search_steps">${collision_guard_binary_search_steps}</param>
          <param name="collision_guard_description_package">marvin_system</param>
          <param name="collision_guard_description_file">description/urdf/marvin_dual.urdf</param>
          <param name="collision_guard_semantic_package">marvin_system</param>
          <param name="collision_guard_semantic_file">description/srdf/marvin_dual.srdf</param>
          <param name="collision_guard_use_gripper_L">${use_gripper_L}</param>
          <param name="collision_guard_use_gripper_R">${use_gripper_R}</param>
          <param name="collision_guard_table_enabled">true</param>
          <param name="collision_guard_table_size">1.2 0.8 0.05</param>
          <param name="collision_guard_table_position">0 0 -0.025</param>
          <param name="collision_guard_table_orientation">0 0 0 1</param>
          <param name="collision_guard_gripper_height_intercept_m">0.15</param>
          <param name="collision_guard_gripper_height_slope_m">-0.03</param>
          <param name="collision_guard_gripper_radius_intercept_m">0.0425</param>
          <param name="collision_guard_gripper_radius_slope_m">0.0575</param>
        </xacro:unless>
      </hardware>

      <!-- Left arm (SDK arm A, index 0) — joints 0..6 -->
      <joint name="Joint1_L">
        <command_interface name="position">
          <param name="min">-3.1067</param>
          <param name="max">3.1067</param>
          <param name="initial_value">1.16</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
      <joint name="Joint2_L">
        <command_interface name="position">
          <param name="min">-2.0944</param>
          <param name="max">2.0944</param>
          <param name="initial_value">-1.28</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
      <joint name="Joint3_L">
        <command_interface name="position">
          <param name="min">-3.1067</param>
          <param name="max">3.1067</param>
          <param name="initial_value">-1.5707963</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
      <joint name="Joint4_L">
        <command_interface name="position">
          <param name="min">-2.5307</param>
          <param name="max">1.0472</param>
          <param name="initial_value">-1.25</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
      <joint name="Joint5_L">
        <command_interface name="position">
          <param name="min">-3.1067</param>
          <param name="max">3.1067</param>
          <param name="initial_value">0.0</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
      <joint name="Joint6_L">
        <command_interface name="position">
          <param name="min">-1.0472</param>
          <param name="max">1.0472</param>
          <param name="initial_value">0.0</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
      <joint name="Joint7_L">
        <command_interface name="position">
          <param name="min">-1.5708</param>
          <param name="max">1.5708</param>
          <param name="initial_value">0.0</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>

      <!-- Right arm (SDK arm B, index 1) — joints 7..13 -->
      <joint name="Joint1_R">
        <command_interface name="position">
          <param name="min">-3.1067</param>
          <param name="max">3.1067</param>
          <param name="initial_value">-1.16</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
      <joint name="Joint2_R">
        <command_interface name="position">
          <param name="min">-2.0944</param>
          <param name="max">2.0944</param>
          <param name="initial_value">-1.28</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
      <joint name="Joint3_R">
        <command_interface name="position">
          <param name="min">-3.1067</param>
          <param name="max">3.1067</param>
          <param name="initial_value">1.5707963</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
      <joint name="Joint4_R">
        <command_interface name="position">
          <param name="min">-2.5307</param>
          <param name="max">1.0472</param>
          <param name="initial_value">-1.25</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
      <joint name="Joint5_R">
        <command_interface name="position">
          <param name="min">-3.1067</param>
          <param name="max">3.1067</param>
          <param name="initial_value">0.0</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
      <joint name="Joint6_R">
        <command_interface name="position">
          <param name="min">-1.0472</param>
          <param name="max">1.0472</param>
          <param name="initial_value">0.0</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
      <joint name="Joint7_R">
        <command_interface name="position">
          <param name="min">-1.5708</param>
          <param name="max">1.5708</param>
          <param name="initial_value">0.0</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>

      <!-- Optional: OmniPicker gripper on left arm -->
      <xacro:if value="${str(use_gripper_L).lower() == 'true'}">
        <joint name="gripper_L">
          <param name="type">omnipicker</param>
          <param name="arm_side">${gripper_L_arm}</param>
          <param name="can_node_id">${gripper_L_can_id}</param>
          <command_interface name="position">
            <param name="min">0.0</param>
            <param name="max">1.0</param>
            <param name="initial_value">0.0</param>
          </command_interface>
          <state_interface name="position"/>
        </joint>
      </xacro:if>

      <!-- Optional: OmniPicker gripper on right arm -->
      <xacro:if value="${str(use_gripper_R).lower() == 'true'}">
        <joint name="gripper_R">
          <param name="type">omnipicker</param>
          <param name="arm_side">${gripper_R_arm}</param>
          <param name="can_node_id">${gripper_R_can_id}</param>
          <command_interface name="position">
            <param name="min">0.0</param>
            <param name="max">1.0</param>
            <param name="initial_value">0.0</param>
          </command_interface>
          <state_interface name="position"/>
        </joint>
      </xacro:if>

    </ros2_control>

  </xacro:macro>

</robot>
