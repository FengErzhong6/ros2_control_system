<?xml version="1.0"?>
<robot name="marvin_dual">
  <group name="left_arm">
    <chain base_link="Base_L" tip_link="Link7_L"/>
  </group>

  <group name="right_arm">
    <chain base_link="Base_R" tip_link="Link7_R"/>
  </group>

  <group name="dual_arm">
    <group name="left_arm"/>
    <group name="right_arm"/>
  </group>

  <group_state name="home" group="left_arm">
    <joint name="Joint1_L" value="1.16"/>
    <joint name="Joint2_L" value="-1.28"/>
    <joint name="Joint3_L" value="-1.5707963"/>
    <joint name="Joint4_L" value="-1.25"/>
    <joint name="Joint5_L" value="0.0"/>
    <joint name="Joint6_L" value="0.0"/>
    <joint name="Joint7_L" value="0.0"/>
  </group_state>

  <group_state name="home" group="right_arm">
    <joint name="Joint1_R" value="-1.16"/>
    <joint name="Joint2_R" value="-1.28"/>
    <joint name="Joint3_R" value="1.5707963"/>
    <joint name="Joint4_R" value="-1.25"/>
    <joint name="Joint5_R" value="0.0"/>
    <joint name="Joint6_R" value="0.0"/>
    <joint name="Joint7_R" value="0.0"/>
  </group_state>

  <group_state name="home" group="dual_arm">
    <joint name="Joint1_L" value="1.16"/>
    <joint name="Joint2_L" value="-1.28"/>
    <joint name="Joint3_L" value="-1.5707963"/>
    <joint name="Joint4_L" value="-1.25"/>
    <joint name="Joint5_L" value="0.0"/>
    <joint name="Joint6_L" value="0.0"/>
    <joint name="Joint7_L" value="0.0"/>
    <joint name="Joint1_R" value="-1.16"/>
    <joint name="Joint2_R" value="-1.28"/>
    <joint name="Joint3_R" value="1.5707963"/>
    <joint name="Joint4_R" value="-1.25"/>
    <joint name="Joint5_R" value="0.0"/>
    <joint name="Joint6_R" value="0.0"/>
    <joint name="Joint7_R" value="0.0"/>
  </group_state>

  <disable_collisions link1="Base_L" link2="Link1_L" reason="Adjacent"/>
  <disable_collisions link1="Link1_L" link2="Link2_L" reason="Adjacent"/>
  <disable_collisions link1="Link2_L" link2="Link3_L" reason="Adjacent"/>
  <disable_collisions link1="Link3_L" link2="Link4_L" reason="Adjacent"/>
  <disable_collisions link1="Link4_L" link2="Link5_L" reason="Adjacent"/>
  <disable_collisions link1="Link5_L" link2="Link6_L" reason="Adjacent"/>
  <disable_collisions link1="Link6_L" link2="Link7_L" reason="Adjacent"/>
  <disable_collisions link1="Link7_L" link2="left_finger_L_link" reason="AdjacentGripperMount"/>
  <disable_collisions link1="Link7_L" link2="right_finger_L_link" reason="AdjacentGripperMount"/>
  <disable_collisions link1="left_finger_L_link" link2="right_finger_L_link" reason="Default"/>

  <disable_collisions link1="Base_R" link2="Link1_R" reason="Adjacent"/>
  <disable_collisions link1="Link1_R" link2="Link2_R" reason="Adjacent"/>
  <disable_collisions link1="Link2_R" link2="Link3_R" reason="Adjacent"/>
  <disable_collisions link1="Link3_R" link2="Link4_R" reason="Adjacent"/>
  <disable_collisions link1="Link4_R" link2="Link5_R" reason="Adjacent"/>
  <disable_collisions link1="Link5_R" link2="Link6_R" reason="Adjacent"/>
  <disable_collisions link1="Link6_R" link2="Link7_R" reason="Adjacent"/>
  <disable_collisions link1="Link7_R" link2="left_finger_R_link" reason="AdjacentGripperMount"/>
  <disable_collisions link1="Link7_R" link2="right_finger_R_link" reason="AdjacentGripperMount"/>
  <disable_collisions link1="left_finger_R_link" link2="right_finger_R_link" reason="Default"/>
</robot>
