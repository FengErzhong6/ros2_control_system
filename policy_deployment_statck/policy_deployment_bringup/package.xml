<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>policy_deployment_bringup</name>
  <version>0.0.1</version>
  <description>Bringup and default recipes for the policy deployment stack.</description>
  <maintainer email="mmlab@example.com">mmlab</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>policy_deployment_orchestrator</depend>
  <depend>policy_deployment_ui</depend>
  <depend>camera_system</depend>
  <depend>marvin_system</depend>
  <depend>wujihand_system</depend>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
