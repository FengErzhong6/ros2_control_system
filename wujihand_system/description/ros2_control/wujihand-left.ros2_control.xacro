<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="wujihand_left_ros2_control" params="name use_mock_hardware usb_serial_number expected_handedness">

    <ros2_control name="${name}" type="system">
      <hardware>
        <xacro:if value="${str(use_mock_hardware).lower() == 'true'}">
          <plugin>mock_components/GenericSystem</plugin>
          <param name="mock_sensor_commands">false</param>
          <param name="state_following_offset">0.0</param>
        </xacro:if>
        <xacro:unless value="${str(use_mock_hardware).lower() == 'true'}">
          <plugin>wujihand_system/WujiHandHardware</plugin>
          <param name="low_pass_cutoff_frequency">5.0</param>
          <param name="usb_serial_number">${usb_serial_number}</param>
          <param name="expected_handedness">${expected_handedness}</param>
        </xacro:unless>
      </hardware>

      <joint name="left_finger1_joint1">
        <command_interface name="position">
          <param name="min">0.0475</param>
          <param name="max">1.6033</param>
          <param name="initial_value">0.0475</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
      <joint name="left_finger1_joint2">
        <command_interface name="position">
          <param name="min">-0.1387</param>
          <param name="max">0.9324</param>
          <param name="initial_value">0.0</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
      <joint name="left_finger1_joint3">
        <command_interface name="position">
          <param name="min">-0.4642</param>
          <param name="max">1.5623</param>
          <param name="initial_value">0.0</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
      <joint name="left_finger1_joint4">
        <command_interface name="position">
          <param name="min">-0.4699</param>
          <param name="max">1.5568</param>
          <param name="initial_value">0.0</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>

      <joint name="left_finger2_joint1">
        <command_interface name="position">
          <param name="min">-0.1585</param>
          <param name="max">1.5604</param>
          <param name="initial_value">0.0</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
      <joint name="left_finger2_joint2">
        <command_interface name="position">
          <param name="min">-0.37</param>
          <param name="max">0.37</param>
          <param name="initial_value">0.0</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
      <joint name="left_finger2_joint3">
        <command_interface name="position">
          <param name="min">-0.4777</param>
          <param name="max">1.5485</param>
          <param name="initial_value">0.0</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
      <joint name="left_finger2_joint4">
        <command_interface name="position">
          <param name="min">-0.4683</param>
          <param name="max">1.5753</param>
          <param name="initial_value">0.0</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>

      <joint name="left_finger3_joint1">
        <command_interface name="position">
          <param name="min">-0.1644</param>
          <param name="max">1.5516</param>
          <param name="initial_value">0.0</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
      <joint name="left_finger3_joint2">
        <command_interface name="position">
          <param name="min">-0.37</param>
          <param name="max">0.37</param>
          <param name="initial_value">0.0</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
      <joint name="left_finger3_joint3">
        <command_interface name="position">
          <param name="min">-0.4739</param>
          <param name="max">1.5512</param>
          <param name="initial_value">0.0</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
      <joint name="left_finger3_joint4">
        <command_interface name="position">
          <param name="min">-0.4684</param>
          <param name="max">1.5745</param>
          <param name="initial_value">0.0</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>

      <joint name="left_finger4_joint1">
        <command_interface name="position">
          <param name="min">-0.1554</param>
          <param name="max">1.5585</param>
          <param name="initial_value">0.0</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
      <joint name="left_finger4_joint2">
        <command_interface name="position">
          <param name="min">-0.37</param>
          <param name="max">0.37</param>
          <param name="initial_value">0.0</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
      <joint name="left_finger4_joint3">
        <command_interface name="position">
          <param name="min">-0.4765</param>
          <param name="max">1.5487</param>
          <param name="initial_value">0.0</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
      <joint name="left_finger4_joint4">
        <command_interface name="position">
          <param name="min">-0.4777</param>
          <param name="max">1.5634</param>
          <param name="initial_value">0.0</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>

      <joint name="left_finger5_joint1">
        <command_interface name="position">
          <param name="min">-0.1626</param>
          <param name="max">1.5585</param>
          <param name="initial_value">0.0</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
      <joint name="left_finger5_joint2">
        <command_interface name="position">
          <param name="min">-0.37</param>
          <param name="max">0.37</param>
          <param name="initial_value">0.0</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
      <joint name="left_finger5_joint3">
        <command_interface name="position">
          <param name="min">-0.4768</param>
          <param name="max">1.5490</param>
          <param name="initial_value">0.0</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
      <joint name="left_finger5_joint4">
        <command_interface name="position">
          <param name="min">-0.4683</param>
          <param name="max">1.5735</param>
          <param name="initial_value">0.0</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
    </ros2_control>

  </xacro:macro>

</robot>
