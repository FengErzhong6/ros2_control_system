<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="wujihand_left_ros2_control" params="name use_mock_hardware usb_serial_number expected_handedness">

    <ros2_control name="${name}" type="system">
      <hardware>
        <xacro:if value="${str(use_mock_hardware).lower() == 'true'}">
          <plugin>mock_components/GenericSystem</plugin>
          <param name="mock_sensor_commands">false</param>
          <param name="state_following_offset">0.0</param>
        </xacro:if>
        <xacro:unless value="${str(use_mock_hardware).lower() == 'true'}">
          <plugin>wujihand_system/WujiHandHardware</plugin>
          <param name="low_pass_cutoff_frequency">5.0</param>
          <param name="usb_serial_number">${usb_serial_number}</param>
          <param name="expected_handedness">${expected_handedness}</param>
        </xacro:unless>
      </hardware>

      <joint name="left_finger1_joint1">
        <command_interface name="position">
          <param name="min">0.0583</param>
          <param name="max">1.5941</param>
          <param name="initial_value">0.0583</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
      <joint name="left_finger1_joint2">
        <command_interface name="position">
          <param name="min">-0.1199</param>
          <param name="max">0.9335</param>
          <param name="initial_value">0.0</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
      <joint name="left_finger1_joint3">
        <command_interface name="position">
          <param name="min">-0.4646</param>
          <param name="max">1.5639</param>
          <param name="initial_value">0.0</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
      <joint name="left_finger1_joint4">
        <command_interface name="position">
          <param name="min">-0.4570</param>
          <param name="max">1.5684</param>
          <param name="initial_value">0.0</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>

      <joint name="left_finger2_joint1">
        <command_interface name="position">
          <param name="min">-0.1560</param>
          <param name="max">1.5619</param>
          <param name="initial_value">0.0</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
      <joint name="left_finger2_joint2">
        <command_interface name="position">
          <param name="min">-0.4095</param>
          <param name="max">0.2921</param>
          <param name="initial_value">0.0</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
      <joint name="left_finger2_joint3">
        <command_interface name="position">
          <param name="min">-0.4839</param>
          <param name="max">1.5466</param>
          <param name="initial_value">0.0</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
      <joint name="left_finger2_joint4">
        <command_interface name="position">
          <param name="min">-0.4723</param>
          <param name="max">1.5754</param>
          <param name="initial_value">0.0</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>

      <joint name="left_finger3_joint1">
        <command_interface name="position">
          <param name="min">-0.1569</param>
          <param name="max">1.5536</param>
          <param name="initial_value">0.0</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
      <joint name="left_finger3_joint2">
        <command_interface name="position">
          <param name="min">-0.3977</param>
          <param name="max">0.3115</param>
          <param name="initial_value">0.0</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
      <joint name="left_finger3_joint3">
        <command_interface name="position">
          <param name="min">-0.4847</param>
          <param name="max">1.5411</param>
          <param name="initial_value">0.0</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
      <joint name="left_finger3_joint4">
        <command_interface name="position">
          <param name="min">-0.4671</param>
          <param name="max">1.5788</param>
          <param name="initial_value">0.0</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>

      <joint name="left_finger4_joint1">
        <command_interface name="position">
          <param name="min">-0.1507</param>
          <param name="max">1.5636</param>
          <param name="initial_value">0.0</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
      <joint name="left_finger4_joint2">
        <command_interface name="position">
          <param name="min">-0.4101</param>
          <param name="max">0.3014</param>
          <param name="initial_value">0.0</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
      <joint name="left_finger4_joint3">
        <command_interface name="position">
          <param name="min">-0.4747</param>
          <param name="max">1.5526</param>
          <param name="initial_value">0.0</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
      <joint name="left_finger4_joint4">
        <command_interface name="position">
          <param name="min">-0.4729</param>
          <param name="max">1.5718</param>
          <param name="initial_value">0.0</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>

      <joint name="left_finger5_joint1">
        <command_interface name="position">
          <param name="min">-0.1578</param>
          <param name="max">1.5632</param>
          <param name="initial_value">0.0</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
      <joint name="left_finger5_joint2">
        <command_interface name="position">
          <param name="min">-0.4103</param>
          <param name="max">0.2949</param>
          <param name="initial_value">0.0</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
      <joint name="left_finger5_joint3">
        <command_interface name="position">
          <param name="min">-0.4733</param>
          <param name="max">1.5560</param>
          <param name="initial_value">0.0</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
      <joint name="left_finger5_joint4">
        <command_interface name="position">
          <param name="min">-0.4662</param>
          <param name="max">1.5760</param>
          <param name="initial_value">0.0</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
    </ros2_control>

  </xacro:macro>

</robot>
